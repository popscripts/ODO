        "@react-navigation/stack": "^7.1.1",
        "eas-cli": "^15.0.10",
        "expo": "~52.0.36",
        "expo-build-properties": "~0.13.2",
        "expo-image-picker": "~16.0.6",
        "expo-linear-gradient": "~14.0.2",
        "expo-navigation-bar": "~4.0.8",
        "expo-status-bar": "~2.0.1",
        "lottie-react-native": "7.1.0",
